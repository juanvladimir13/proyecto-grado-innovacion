\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilos/caratula}[2026/08/29 Estilos y diagramacion modular de la Caratula Oficial BTH]

% ============================================================
% PAQUETES REQUERIDOS PARA LA CARÁTULA
% ============================================================
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{eso-pic}
\RequirePackage{setspace}
\RequirePackage{etoolbox}

% ============================================================
% 1. MARCO PERIMETRAL DECORATIVO BTH
% ============================================================
% Inserción del marco perimetral azul en segundo plano (solo en la carátula)
\newcommand{\insertarmarcobth}{%
    \ifdefstring{\activarmarcobth}{true}{%
        \AddToShipoutPictureBG*{%
            \AtPageCenter{%
                \makebox(0,0){%
                    \includegraphics[width=\anchomarcobth,height=\altomarcobth]{\rutamarcobth}%
                }%
            }%
        }%
    }{}%
}

% ============================================================
% ============================================================
% 2. TIPOGRAFÍA Y FORMATO DE BLOQUES INDIVIDUALES (docs/formato.md)
% ============================================================
% 1. Módulo Tecnológico Productivo San Julián (Tamaño 14)
\newcommand{\institucionportadabth}[1]{%
    \begin{minipage}{0.85\textwidth}
        \centering\fontsize{14pt}{17pt}\selectfont\bfseries\setstretch{1.15} #1\par
    \end{minipage}\par
}

% 2. Nombre de la Carrera (Tamaño 14)
\newcommand{\especialidadportadabth}[1]{{\fontsize{14pt}{17pt}\selectfont\bfseries ``#1''\par}}

% 4. Título del Proyecto en letra tamaño 14 (no debe exceder de 17 palabras)
\newcommand{\tituloportadabth}[1]{%
    \begin{minipage}{0.82\textwidth}
        \centering\fontsize{14pt}{17pt}\selectfont\bfseries\setstretch{1.2} #1\par
    \end{minipage}\par
}

% 5. Proyecto para optar el grado Técnico Medio (Tamaño 12)
\newcommand{\formulagradoportadabth}[1]{%
    \begin{minipage}{0.88\textwidth}
        \centering\fontsize{12pt}{15pt}\selectfont\setstretch{1.15} #1\par
    \end{minipage}\par
}

% 6. Nombre de los postulantes (Tamaño 12)
\newcommand{\etiquetapostulantesbth}[1]{{\fontsize{12pt}{15pt}\selectfont\bfseries #1\par}}

% 7. Nombre del Tutor/a: (Tamaño 12)
\newcommand{\etiquetatutorbth}[1]{{\fontsize{12pt}{15pt}\selectfont\bfseries #1\par\vspace{-\parskip}}}

\newcommand{\tutorportadabth}[1]{{\fontsize{12pt}{15pt}\selectfont\setstretch{1.0} #1\par}}

% 8 y 9. Lugar y Año (Tamaño 12)
\newcommand{\pieportadabth}[2]{{\fontsize{12pt}{15pt}\selectfont\bfseries\setstretch{1.1} #1\\#2\par}}

% Macros de compatibilidad tipográfica previa
\newcommand{\titulocaratula}[1]{\tituloportadabth{#1}}
\newcommand{\subtitulocaratula}[1]{\formulagradoportadabth{#1}}

% ============================================================
% 3. BLOQUES SEMÁNTICOS ESTRUCTURADOS CON ESPACIADO INTEGRADO
% ============================================================
\newcommand{\bloqueinstitucionportada}[2]{%
    \vspace*{0.2cm}%
    \institucionportadabth{#1}%
    \vspace{0.25cm}%
    \especialidadportadabth{#2}%
}

% 3. Logo del BTH San Julián (Tamaño de imagen 6 cm x 4.5 cm máximo, manteniendo proporción)
\newcommand{\bloquelogoportada}[2][\anchologobth]{%
    \vspace{0.35cm}%
    \par{\centering\includegraphics[width=#1,height=\alturalogobth,keepaspectratio]{#2}\par}%
    \vspace{0.4cm}%
}

\newcommand{\bloquetituloportada}[1]{%
    \tituloportadabth{#1}%
    \vspace{0.45cm}%
}

\newcommand{\bloquegradoportada}[1]{%
    \formulagradoportadabth{#1}%
    \vspace{0.7cm}%
}

\newcommand{\bloquepostulantesportada}[3]{%
    \begin{minipage}{0.55\textwidth}
        \fontsize{12pt}{15pt}\selectfont
        \etiquetapostulantesbth{#1}%
        \vspace{0.15cm}%
        \ifdefempty{#3}{%
            \noindent #2\par
        }{%
            \ifblank{#3}{%
                \noindent #2\par
            }{%
                \noindent 1. #2\par
                \vspace{0.12cm}%
                \noindent 2. #3\par
            }%
        }%
    \end{minipage}\par
    \vspace{0.55cm}%
}

\newcommand{\bloquetutorportada}[2]{%
    \begin{minipage}{0.55\textwidth}
        \fontsize{12pt}{15pt}\selectfont
        \etiquetatutorbth{#1}%
        \vspace{0.10cm}%
        \tutorportadabth{#2}%
    \end{minipage}\par
    \vfill
}

\newcommand{\bloquepieportada}[2]{%
    \pieportadabth{#1}{#2}%
    \vspace*{2.0cm}%
}

% ============================================================
% 4. ENTORNO Y COMANDO GLOBAL DE CARÁTULA
% ============================================================
% Entorno que encapsula la geometría (docs/formato.md),
% tipografía Times New Roman (ptm), marco decorativo y centrado.
\newenvironment{estilocaratulabth}{%
    \newgeometry{left=\margenizquierdo, right=\margenderecho, top=\margensuperior, bottom=\margeninferior}%
    \begin{titlepage}%
        \renewcommand{\familydefault}{ptm}%
        \fontfamily{ptm}\selectfont
        \insertarmarcobth
        \centering
}{%
    \end{titlepage}%
    \restoregeometry
    \normalfont
}

% Alias semántico
\let\estilocaratula\estilocaratulabth
\let\endestilocaratula\endestilocaratulabth

% Comando de alto nivel para generar automáticamente la carátula
% oficial a partir de las variables de estilos/configuracion.tex
\newcommand{\imprimircaratulabth}{%
    \begin{estilocaratulabth}
        \bloqueinstitucionportada{\institucion}{\especialidad}%
        \bloquelogoportada{\rutalogobth}%
        \bloquetituloportada{\tituloproyecto}%
        \bloquegradoportada{\formulagradobth}%
        \bloquepostulantesportada{\etiquetaautor}{\autoruno}{\autordos}%
        \bloquetutorportada{\etiquetatutor}{\tutorproyecto}%
        \bloquepieportada{\lugarproyecto}{\gestionproyecto}%
    \end{estilocaratulabth}%
}

% Alias semántico
\newcommand{\imprimircaratula}{\imprimircaratulabth}

\endinput
